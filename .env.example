NEXT_PUBLIC_S3_BASE_URL=https://storage.yandexcloud.net/rbstorage
NEXT_PUBLIC_SITE_URL=https://schupy.ru
# Primary delivery channel. mail.ru SMTP requires a paid plan for custom-domain
# mailboxes and Web3Forms rejects server-side calls on the free tier, so this
# points at an SMTP relay such as Brevo (smtp-relay.brevo.com, port 587).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# Brevo SMTP login/key from Settings -> SMTP & API -> SMTP tab (not a mailbox).
SMTP_USER=
SMTP_PASSWORD=
# Sender address shown to recipients — must be verified as a sender in Brevo.
MAIL_FROM=zakaz@schupy.ru
# Where inquiries land; can be any address, independent of MAIL_FROM/SMTP_USER.
CONTACT_TO=zakaz@schupy.ru
# Fallback only; stays broken on the free Web3Forms tier for server-side calls
# unless upgraded to Pro with the VPS IP registered. Safe to leave empty.
WEB3FORMS_ACCESS_KEY=
